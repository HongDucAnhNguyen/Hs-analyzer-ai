# API Configuration
API_HOST=0.0.0.0
API_PORT=8080
API_WORKERS=4
DEBUG=False

# LLM API Keys
OPENAI_API_KEY=your_openai_key_here
GEMINI_API_KEY=your_gemini_key_here
ANTHROPIC_API_KEY=your_anthropic_key_here
COHERE_API_KEY=your_cohere_key_here

# RAG Service Configuration
LLM_PROVIDER=gemini
LLM_MODEL=gemini-2.5-flash
LLM_TEMPERATURE=0.0

# Qdrant Configuration (using remote server)
QDRANT_HOST=34.143.173.34
QDRANT_PORT=6333
QDRANT_COLLECTION=hs_code_db_gemini

# Optional: Elasticsearch Configuration
ES_URL=

# Optional: Neo4j Graph Database Configuration
GRAPH_DB_URL=
GRAPH_USER=
GRAPH_PASSWORD=
DB_NAME=

# Optional: Logfire Monitoring
LOGFIRE_TOKEN=
LOGFIRE_ENVIRONMENT=production

# Classifier Service Configuration
CLASSIFIER_LLM_PROVIDER=gemini
CLASSIFIER_LLM_MODEL=gemini-2.5-pro

# Redis and RabbitMQ (automatically configured in docker-compose)
REDIS_URL=redis://redis:6379/0
RABBITMQ_URL=amqp://admin:admin123@rabbitmq:5672/

JWT_SECRET_KEY=your_secret_key
ACCESS_TOKEN_EXPIRE_MINUTES=2400
REFRESH_TOKEN_EXPIRE_DAYS=30

# MinIO Configuration
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123
MINIO_INTERNAL_ENDPOINT=minio:9000
MINIO_EXTERNAL_ENDPOINT=localhost:9000
MINIO_BUCKET=reports
MINIO_SECURE=false
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# =============================================================================
# Authentication Configuration
# =============================================================================
AUTH_USERNAME=username
AUTH_PASSWORD_HASH=$2b$12$xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
AUTH_TOKEN_VERSION=0

# =============================================================================
# Email Configuration (for Password Rotation)
# =============================================================================
# Gmail SMTP settings
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=admin@gmail.com
# IMPORTANT: Use Gmail App Password, not your regular password
# Generate at: https://myaccount.google.com/apppasswords
SMTP_PASSWORD=your_gmail_app_password_here

# Email sender and recipients
EMAIL_SENDER=admin@gmail.com
# Comma-separated list of email recipients for password notifications
EMAIL_RECIPIENTS=client1@gmail.com,client2@gmail.com
# Optional: Comma-separated list of BCC recipients (e.g., senior managers)
EMAIL_BCC_RECIPIENTS=senior1@gmail.com,senior2@gmail.com
